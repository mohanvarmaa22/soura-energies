# Lead delivery. Configure at least one channel. In production the form returns an error if none is set.
RESEND_API_KEY=
LEAD_TO_EMAIL=            # comma-separated for several recipients
LEAD_FROM_EMAIL=          # must be a sender verified in Resend
SHEETS_WEBHOOK_URL=       # Google Apps Script web app URL (see docs/google-sheet-setup.md)
SHEETS_WEBHOOK_SECRET=    # shared secret checked by the Apps Script

# Analytics. Inlined at build time (pass as a Docker build arg). Leave empty to disable GA and the cookie banner.
NEXT_PUBLIC_GA_ID=        # GA4 measurement id, e.g. G-XXXXXXXXXX

# Canonical origin for sitemap, Open Graph and structured data. Build time.
NEXT_PUBLIC_SITE_URL=     # e.g. https://souraenergies.in
